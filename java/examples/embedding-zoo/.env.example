# Leave MONGODB_URI empty to use the in-process store for the CLI demo.
# Set it to an Atlas connection string to store vectors and use $vectorSearch.
MONGODB_URI=
MONGODB_DATABASE=embedding_zoo
MONGODB_COLLECTION=evidence

# Chat model for the agent runtime. The CLI demo does not call it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Text embeddings: minilm (local ONNX, the default) or openai.
EMBEDDING_ZOO_TEXT_PROVIDER=minilm
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

EMBEDDING_ZOO_MAX_SNAPSHOTS=48
EMBEDDING_ZOO_MAX_LOG_LINES=400
EMBEDDING_ZOO_MAX_IMAGES=16
EMBEDDING_ZOO_ANALOGY_CUTOFF=0.45
