# Leave MONGODB_URI empty to use the in-process store for the CLI demo.
# Set it to an Atlas connection string to store vectors and use $vectorSearch.
MONGODB_URI=
MONGODB_DATABASE=near_miss
MONGODB_COLLECTION=evidence

# Chat model for the agent runtime. The CLI demo does not call it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Text embeddings: minilm (local ONNX, the default), openai or voyage.
NEAR_MISS_TEXT_PROVIDER=minilm
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
# Voyage AI through Atlas: the same key the memory server uses (a model API key from
# Atlas). A key from voyageai.com needs NEAR_MISS_VOYAGE_BASE_URL=https://api.voyageai.com/v1.
VOYAGE_API_KEY=
NEAR_MISS_VOYAGE_MODEL=voyage-4
NEAR_MISS_VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Reports kept per device type (MAUDE) and per vehicle (NHTSA).
NEAR_MISS_RECORDS_PER_QUERY=25
NEAR_MISS_ANALOGY_CUTOFF=0.45
